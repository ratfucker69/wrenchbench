{
  "name": "dsh-wrenchbench",
  "version": "0.2.1",
  "private": true,
  "description": "WrenchBench: a board-level repair workbench in the sidebar - boardview import and canvas, per-board schematic ingestion, a persistent board library, and agent tools that read the same board the canvas shows.",
  "type": "module",
  "main": "index.js",
  "scripts": {
    "test": "node test/run-all.mjs"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "parsers.js",
    "xzz.js",
    "xzz-des.js",
    "diagnose.js",
    "naming.js",
    "rails.js",
    "schematic.js",
    "pdf-text.js",
    "pdf-objects.js",
    "zip.js",
    "store.js",
    "scripts/load-board.mjs",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  }
}
